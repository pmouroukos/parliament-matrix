# Copy to .env.local and fill in project credentials from the Supabase dashboard.
# Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Keep mock data until tables and row mapping exist.
# Switch to "supabase" only after the SQL schema is finalized.
NEXT_PUBLIC_DATA_SOURCE=mock
